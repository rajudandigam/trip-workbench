# Copy to .env for local development. Never commit .env.

NODE_ENV=development
PORT=3000
API_PORT=3001

# Docker Compose maps host 5433 → container 5432 (see docker-compose.yml).
# On Homebrew Postgres without Docker, use your local superuser URL on 5432, e.g.:
# DATABASE_URL=postgresql://dand@127.0.0.1:5432/trip_workbench
DATABASE_URL=postgresql://trip_workbench:trip_workbench@127.0.0.1:5433/trip_workbench
TEST_DATABASE_URL=postgresql://trip_workbench:trip_workbench@127.0.0.1:5433/trip_workbench_test
ALLOWED_DB_NAME_PATTERN=trip_workbench

SESSION_SECRET=dev-only-session-secret-change-me
COOKIE_NAME=tw_session
SEED_PASSWORD=Password123!
APP_TIMEZONE=America/Los_Angeles

# disabled | fixture | live
AI_MODE=disabled
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Injected only in tests via process env — never via public query params
# DEMO_FIXED_NOW=2026-10-14T19:00:00.000Z
